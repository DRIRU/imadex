# Copy this file to `.env` in the same folder to enable authenticated tunnel
# mode. Leave both values unset for local loopback-only access.
#
# The public origin must be a clean HTTPS origin with no path, query, or
# fragment, and the password must be at least 16 characters.
# FRAME_PUBLIC_ORIGIN=https://photos.example.com
# FRAME_PASSWORD=choose-a-password-of-at-least-16-characters

# Optional: use an external Qdrant server instead of embedded local mode
# (data/vectors/). When running everything with Docker Compose, use the service
# name as the host: http://qdrant:6333 (CPU) or http://qdrant-gpu:6333 (GPU).
# From a native install on the same PC, use http://127.0.0.1:6333 instead.
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=images_clip_b32_v1
